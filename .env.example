# Copy to .env for `npm run dev`. Recordings go to .data/, encrypted; sign-in codes are printed in the terminal.
# Make a key with: openssl rand -base64 32
STORAGE_KEY=
# Signs you in as this address on localhost, without a code. Leave it empty to try the sign-in.
DEV_EMAIL=you@example.com
REVIEWERS=you@example.com
ADMINS=you@example.com
