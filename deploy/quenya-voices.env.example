# Settings of the site, in /etc/quenya-voices.env on the server (readable by root and the quenya user only).
# After changing them: sudo systemctl restart quenya-voices

# Gcore object storage (Cloud > Object Storage), S3 Standard in Luxembourg-2
STORAGE_ENDPOINT=https://luxembourg-2.storage.gcore.dev
STORAGE_REGION=s-ed1
STORAGE_BUCKET=quenya-recordings
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Encrypts every object before it is stored: openssl rand -base64 32. Keep a copy in your password manager:
# without it the recordings cannot be read, not even for training.
STORAGE_KEY=

# Who reviews and who invites (comma-separated e-mails; they are always invited)
REVIEWERS=
ADMINS=

# Brevo sends the sign-in codes (Settings > SMTP & API in Brevo). SMTP_USER is the login Brevo shows there,
# SMTP_PASSWORD an SMTP key made there (not the API key). MAIL_FROM must be on the domain authenticated in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Quenya Voices <noreply@pacheco.lu>"
